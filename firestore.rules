rules_version = '2';

// Firestore security rules for Remindrr
//
// Data model:
//   /users/{uid}/data/{document}    → settings, invoices, clients
//
// Rules: a user can read/write only their own data, identified by their
// Firebase Auth UID. The uid in the path must match the requesting user's
// auth.uid.
//
// Deploy:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // User data — only the owner can read/write
    match /users/{uid}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
